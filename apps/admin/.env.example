# Panel de administración (BFF). Copiar a .env.local; nunca versionar secretos.
API_BASE_URL=http://localhost:3001/api/v1
# Mínimo 32 caracteres aleatorios: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Proxies de confianza delante de Next (0 = no se reenvía X-Forwarded-For). El proxy de entrada debe sobrescribir la cabecera.
TRUSTED_PROXY_HOPS=0
# Orígenes extra permitidos en Server Actions (separados por coma), p. ej. https://admin.peruwonders.pe
ADMIN_TRUSTED_ORIGINS=
ADMIN_API_TIMEOUT_MS=10000

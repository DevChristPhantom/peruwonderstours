# Panel de administración (BFF). Copiar a .env.local; nunca versionar secretos.
API_BASE_URL=http://localhost:3001/api/v1
# Mínimo 32 caracteres aleatorios: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=
# Proxies de confianza delante de Next (0 = no se reenvía X-Forwarded-For). El proxy de entrada debe sobrescribir la cabecera.
TRUSTED_PROXY_HOPS=0
# Orígenes extra permitidos en Server Actions (separados por coma); usar el origen real del panel cuando se acuerde el hosting.
ADMIN_TRUSTED_ORIGINS=
ADMIN_API_TIMEOUT_MS=10000

# Aviso a la web pública tras cada cambio de contenido (portadas, tours, precios, blog, banners).
# Mismo valor que REVALIDATE_SECRET de apps/web. Sin definir, no se avisa (la web tarda ≤ 1 h).
REVALIDATE_SECRET=
# Opcional: endpoints a avisar, separados por coma. Por defecto: PUBLIC_WEB_BASE_URL + /api/revalidate
WEB_REVALIDATE_URLS=

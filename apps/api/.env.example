# Peru Wonders Tours API — copiar a .env (no versionado) y ajustar. SIN secretos reales aquí.
NODE_ENV=development
PORT=3001

# prisma = PostgreSQL | seed = catálogo de data/seed en memoria | memory = memoria vacía
DATA_SOURCE=seed
# Solo si DATA_SOURCE=prisma. Formato: postgresql://USUARIO:CLAVE@localhost:5433/pwt_dev?schema=public
DATABASE_URL=
SEED_DATA_DIR=../../data/seed
# Genera tarifas y salidas FICTICIAS (solo memoria) para probar carrito y checkout.
DEMO_PRICING=false

# Allowlist CORS (orígenes exactos separados por coma). El front llama a la API desde su servidor.
WEB_ORIGIN=http://localhost:3000
# trust proxy de Express: false | true | nº de saltos | IPs/subredes | loopback. Determina req.ip
# (rate limiting). El servidor de Next debe reenviar la IP del visitante en X-Forwarded-For.
TRUST_PROXY=loopback
# Límite del cuerpo de la petición (KiB).
BODY_LIMIT_KB=100
# Rate limiting por IP: ventana (s), límite global y límite estricto (checkout, pagos, reclamaciones).
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
THROTTLE_STRICT_LIMIT=10
SWAGGER_ENABLED=true
PROBLEM_TYPE_BASE_URL=https://peruwonderstours.com/problems

# Pasarela simulada (desarrollo). Generar un valor aleatorio local, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_GATEWAY=sandbox
SANDBOX_WEBHOOK_SECRET=replace-with-a-random-local-value
SANDBOX_CHECKOUT_BASE_URL=http://localhost:3001/api/v1/sandbox/checkout
WEBHOOK_TOLERANCE_SECONDS=300

# Política de pago — SUPUESTOS PENDIENTES DEL CLIENTE (RN-01/02/13/14)
DEPOSIT_DEFAULT_PERCENT=50
BALANCE_DUE_DAYS_BEFORE_SERVICE=7
FULL_PAYMENT_WITHIN_DAYS=7
THIRD_PARTY_TICKETS_REQUIRE_FULL=true
HOLD_TTL_MINUTES=15
CART_TTL_DAYS=7
PRICE_LOCK_MINUTES=30
IDEMPOTENCY_TTL_HOURS=24
TERMS_VERSION=2026-10-draft
CANCELLATION_POLICY_VERSION=2026-10-draft

# Libro de Reclamaciones — datos del proveedor congelados en cada hoja (Anexo I).
# POR CONFIRMAR con el cliente; la API los exige reales en producción.
PROVIDER_LEGAL_NAME=POR CONFIRMAR
PROVIDER_RUC=POR CONFIRMAR
ESTABLISHMENT_ADDRESS=POR CONFIRMAR
ESTABLISHMENT_CODE=WEB
COMPLAINT_CONFORMITY_TEXT_VERSION=2026-10-draft
PRIVACY_NOTICE_VERSION=2026-10-draft

# Cifrado de datos personales (AES-256-GCM). 32 bytes en base64; obligatoria en producción.
# Sin valor, en desarrollo se usa una clave fija NO secreta. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=

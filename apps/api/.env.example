# Peru Wonders Tours API — copiar a .env (no versionado) y ajustar. SIN secretos reales aquí.
NODE_ENV=development
PORT=3001

# prisma = PostgreSQL | seed = catálogo de data/seed en memoria | memory = memoria vacía
DATA_SOURCE=seed
# Solo si DATA_SOURCE=prisma. Formato: postgresql://USUARIO:CLAVE@localhost:5433/pwt_dev?schema=public
DATABASE_URL=
SEED_DATA_DIR=../../data/seed
# Genera tarifas y salidas FICTICIAS (solo memoria) para probar carrito y checkout.
DEMO_PRICING=false

# Allowlist CORS (orígenes exactos separados por coma). El front llama a la API desde su servidor.
WEB_ORIGIN=http://localhost:3000
# trust proxy de Express: false | true | nº de saltos | IPs/subredes | loopback. Determina req.ip
# (rate limiting). El servidor de Next debe reenviar la IP del visitante en X-Forwarded-For.
TRUST_PROXY=loopback
# Límite del cuerpo de la petición (KiB).
BODY_LIMIT_KB=100
# Rate limiting por IP: ventana (s), límite global y límite estricto (checkout, pagos, reclamaciones).
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
THROTTLE_STRICT_LIMIT=10
SWAGGER_ENABLED=true
PROBLEM_TYPE_BASE_URL=https://peruwonderstours.com/problems

# Pasarela simulada (desarrollo). Generar un valor aleatorio local, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_GATEWAY=sandbox
SANDBOX_WEBHOOK_SECRET=replace-with-a-random-local-value
SANDBOX_CHECKOUT_BASE_URL=http://localhost:3001/api/v1/sandbox/checkout
WEBHOOK_TOLERANCE_SECONDS=300

# Política de pago — SUPUESTOS PENDIENTES DEL CLIENTE (RN-01/02/13/14)
DEPOSIT_DEFAULT_PERCENT=50
BALANCE_DUE_DAYS_BEFORE_SERVICE=7
FULL_PAYMENT_WITHIN_DAYS=7
THIRD_PARTY_TICKETS_REQUIRE_FULL=true
HOLD_TTL_MINUTES=15
CART_TTL_DAYS=7
PRICE_LOCK_MINUTES=30
IDEMPOTENCY_TTL_HOURS=24
TERMS_VERSION=2026-10-draft
CANCELLATION_POLICY_VERSION=2026-10-draft

# Libro de Reclamaciones — datos del proveedor congelados en cada hoja (Anexo I).
# POR CONFIRMAR con el cliente; la API los exige reales en producción.
PROVIDER_LEGAL_NAME=POR CONFIRMAR
PROVIDER_RUC=POR CONFIRMAR
ESTABLISHMENT_ADDRESS=POR CONFIRMAR
ESTABLISHMENT_CODE=WEB
COMPLAINT_CONFORMITY_TEXT_VERSION=2026-10-draft
PRIVACY_NOTICE_VERSION=2026-10-draft

# Cifrado de datos personales (AES-256-GCM). 32 bytes en base64; obligatoria en producción.
# Sin valor, en desarrollo se usa una clave fija NO secreta. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=

# --- Sprint 2: auth del staff (backoffice) ---
# Secreto HS256 de los JWT de acceso (>= 32 caracteres; obligatorio en producción). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Sin valor en desarrollo se usa uno EFÍMERO (las sesiones mueren al reiniciar la API).
JWT_ACCESS_SECRET=
JWT_ISSUER=pwt-api
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_IDLE_TTL_HOURS=12
REFRESH_ABSOLUTE_TTL_HOURS=72
# Bloqueo progresivo: desde el fallo N se bloquea BASE s, duplicando hasta MAX s.
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_BASE_SECONDS=60
LOGIN_LOCK_MAX_SECONDS=3600
MFA_ISSUER=Peru Wonders Tours

# --- Correo transaccional ---
# file = .eml en MAIL_OUTBOX_DIR (desarrollo, gitignored) | smtp | memory (pruebas) | disabled
MAIL_TRANSPORT=file
MAIL_OUTBOX_DIR=.mail-outbox
MAIL_FROM=Peru Wonders Tours <no-reply@peruwonderstours.com>
MAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
OUTBOX_RELAY_ENABLED=true
OUTBOX_RELAY_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BATCH_SIZE=20
REMINDER_JOB_INTERVAL_MS=900000
PUBLIC_WEB_BASE_URL=http://localhost:3000
CONTACT_EMAIL=reservas@peruwonderstours.com
CONTACT_PHONE=POR CONFIRMAR

# --- Protección de datos ---
# HMAC de los enlaces de baja de marketing (>= 32; obligatorio en producción).
MARKETING_LINK_SECRET=
MARKETING_CONSENT_VERSION=2026-10-draft

# --- Política de cancelación (SUPUESTO pendiente del cliente) ---
# % de lo pagado que se reembolsa según días HÁBILES antes del primer servicio.
CANCELLATION_REFUND_TIERS=[{"minBusinessDaysBefore":20,"refundPercent":100},{"minBusinessDaysBefore":8,"refundPercent":50},{"minBusinessDaysBefore":0,"refundPercent":0}]

// =============================================================================
// Peru Wonders Tours — modelo de datos MVP (PostgreSQL 16 + Prisma 7.x)
// Documentación y ERD: brain/wiki/concepts/modelo-de-datos.md
//
// Convenciones:
//   - Modelos PascalCase / campos camelCase -> tablas y columnas snake_case (@@map/@map).
//   - PK uuid v7 (ordenable en el tiempo, buen comportamiento en índices B-tree).
//   - Dinero: BigInt en céntimos + currency Char(3) (ISO 4217: PEN, USD). Nunca float.
//   - Fechas-hora: timestamptz (UTC). Fechas de calendario (viaje, vigencias): date.
//   - CHECK, triggers, EXCLUDE, tsvector y extensiones: prisma/sql/constraints.sql
//     (Prisma no los modela; se aplican como migración SQL aparte).
//   - Prisma 7: la URL de conexión vive en prisma.config.ts -> env("DATABASE_URL").
// =============================================================================

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  // Prisma 7 ya no acepta `url` en el schema: se lee env("DATABASE_URL") en prisma.config.ts.
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Locale {

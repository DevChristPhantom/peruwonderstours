  en
  pt

  @@map("locale")
}

enum PublicationStatus {
  draft
  published
  archived

  @@map("publication_status")
}

enum TourType {
  tour
  package
  transfer

  @@map("tour_type")
}

enum Difficulty {
  easy
  moderate
  challenging
  extreme

  @@map("difficulty")
}

enum MediaKind {
  image
  video

  @@map("media_kind")
}

enum PaxType {
  adult
  child
  student
  senior

  @@map("pax_type")
}

enum Residency {
  national
  foreign

  @@map("residency")
}

enum CartStatus {
  active
  converted
  abandoned
  expired

  @@map("cart_status")
}

enum HoldStatus {
  active
  converted
  released
  expired

  @@map("hold_status")
}

enum BookingStatus {

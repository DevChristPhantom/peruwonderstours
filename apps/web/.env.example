# Peru Wonders Tours — copiar a .env.local. Sin secretos reales.
# API_BASE_URL se usa solo en el servidor de Next e incluye /api/v1.
API_BASE_URL=http://localhost:3001/api/v1
CATALOG_SOURCE=api
CATALOG_CURRENCY=PEN
PWT_API_TIMEOUT_MS=8000

# Sandbox simulado. live NO instala ni configura una pasarela real.
NEXT_PUBLIC_PAYMENTS_MODE=sandbox
# WhatsApp confirmado por el cliente.
NEXT_PUBLIC_WHATSAPP_NUMBER=51924278597

# Ajustar únicamente según la cadena de proxies real del hosting.
TRUSTED_PROXY_HOPS=0
CSP_REPORT_ONLY=false
# Solo para next start LOCAL contra una API HTTP; nunca para un sitio público.
API_ALLOW_HTTP=false
# CARD_FEE_PERCENT: dejar sin definir hasta que la API cobre la comisión aprobada.
# PWT_LEGAL_* se genera desde docs/legal por next.config.ts; no configurarlo aquí.

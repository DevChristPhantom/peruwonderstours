# peruwonderstours en Caddy. Copiar a /srv/proxy/sites/ (lo hace deploy/scripts/deploy.sh).
# Variables en /srv/proxy/proxy.env:
#   PWT_WEB_DOMAIN     peruwonderstours.com
#   PWT_WEB_REDIRECTS  www.peruwonderstours.com, prueba.peruwonderstours.com  (redirigen al principal)
#   PWT_ADMIN_DOMAIN   panel.peruwonderstours.com
#   PWT_STAGING_USER / PWT_STAGING_HASH   usuario y hash de la contraseña de la fase de pruebas
#                      (hash: docker compose exec caddy caddy hash-password)
# Lanzamiento: borrar el bloque basic_auth y el X-Robots-Tag. Ver docs/manual/despliegue.md.

(pwt_maintenance) {
	# Web apagada (despliegue o caída): página estática con 503 temporal (Google no desindexa).
	handle_errors 502 503 504 {
		root * /srv/static/peruwonderstours
		rewrite * /mantenimiento.html
		header Retry-After 600
		header Cache-Control no-store
		file_server {
			status 503
		}
	}
}

{$PWT_WEB_DOMAIN} {
	import common
	import pwt_maintenance

	# --- Solo fase de pruebas: contraseña y fuera de Google. Quitar al lanzar. ---
	basic_auth {
		{$PWT_STAGING_USER} {$PWT_STAGING_HASH}
	}
	header X-Robots-Tag "noindex, nofollow"
	# --- fin fase de pruebas ---

	# Fotos y videos subidos desde el panel (la API los sirve con caché inmutable).
	handle /media/* {
		import upstream pwt-api:3001
	}
	handle {
		import upstream pwt-web:3000
	}
}

{$PWT_ADMIN_DOMAIN} {
	import common
	import pwt_maintenance
	header X-Robots-Tag "noindex, nofollow, noarchive"
	import upstream pwt-admin:3000
}

# Direcciones secundarias → dominio principal (PWT_WEB_REDIRECTS en proxy.env, obligatoria, separadas
# por coma; p. ej. "www.peruwonderstours.com, prueba.peruwonderstours.com").
{$PWT_WEB_REDIRECTS} {
	import common
	redir https://{$PWT_WEB_DOMAIN}{uri} permanent
}

# Caddy compartido. Configuración global + un archivo por sitio en sites/.
{
	# Correo para avisos de Let's Encrypt (vencimientos). Va en proxy.env: ACME_EMAIL=...
	email {$ACME_EMAIL}

	servers {
		# Cloudflare delante (proxy naranja): se confía en sus rangos para saber la IP real del
		# visitante (https://www.cloudflare.com/ips/ — revisar si Cloudflare los cambia).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# Bloques reutilizables por los sitios.
(common) {
	encode zstd gzip
	header -Server
}

# `import upstream <host:puerto>`: la app recibe UNA sola IP en X-Forwarded-For, la real del
# visitante ya resuelta tras Cloudflare. Por eso web y panel usan TRUSTED_PROXY_HOPS=1.
(upstream) {
	reverse_proxy {args[0]} {
		header_up X-Forwarded-For {client_ip}
	}
}

import /etc/caddy/sites/*.caddy

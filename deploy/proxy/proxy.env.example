# Copiar a /srv/proxy/proxy.env (permisos 600). Sin secretos reales en el repositorio.
# Opcional (ver el Caddyfile): ACME_EMAIL=correo-del-administrador@ejemplo.com

# peruwonderstours
PWT_WEB_DOMAIN=peruwonderstours.com
# Redirigen al dominio principal (obligatoria; separadas por coma).
PWT_WEB_REDIRECTS=www.peruwonderstours.com, prueba.peruwonderstours.com
PWT_ADMIN_DOMAIN=panel.peruwonderstours.com
# Fase de pruebas: usuario y HASH (no la contraseña) generado con:
#   docker compose exec caddy caddy hash-password
# Entre comillas SIMPLES: el hash lleva "$" y Docker Compose los interpretaría como variables.
PWT_STAGING_USER=prueba
PWT_STAGING_HASH='$2a$14$reemplazar-por-el-hash-generado'
